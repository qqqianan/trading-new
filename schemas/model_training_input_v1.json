{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelTrainingInput v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "data_kind",
    "artifact_root",
    "dataset_descriptor",
    "schema_descriptor",
    "lineage_descriptor",
    "preprocessor_descriptors",
    "development_data_sha256",
    "holdout_ledger_root",
    "holdout_spec_id",
    "experiment"
  ],
  "properties": {
    "purpose": {"enum": ["research_only", "investment_decision"]},
    "data_kind": {"enum": ["governed_real", "synthetic_qa"]},
    "artifact_root": {"type": "string", "minLength": 1},
    "dataset_descriptor": {"$ref": "#/$defs/datasetDescriptor"},
    "schema_descriptor": {"$ref": "#/$defs/contentDescriptor"},
    "lineage_descriptor": {"$ref": "#/$defs/contentDescriptor"},
    "preprocessor_descriptors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/preprocessorDescriptor"}
    },
    "development_data_sha256": {"$ref": "#/$defs/sha256"},
    "holdout_ledger_root": {"type": "string", "minLength": 1},
    "holdout_spec_id": {"type": "string", "pattern": "^holdout_spec_[0-9a-f]{64}$"},
    "experiment": {"$ref": "#/$defs/experiment"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contentDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "data_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "data_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "datasetDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "manifest_path", "data_sha256"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^ds_[0-9a-f]+$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "data_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "preprocessorDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "manifest_path", "data_sha256"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^preprocessor_artifact_[0-9a-f]{64}$"
        },
        "manifest_path": {"type": "string", "minLength": 1},
        "data_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_run_id",
        "dataset_snapshot_id",
        "schema_manifest_id",
        "lineage_manifest_id",
        "rulebook_version",
        "git_commit",
        "model_family",
        "feature_names",
        "size_feature_name",
        "label_name",
        "split_protocol",
        "random_seed",
        "final_test_runs",
        "ridge_alphas",
        "preprocessor_artifact_ids",
        "trial_batch_id",
        "factor_report_id",
        "portfolio_backtest_id",
        "portfolio_rule_version",
        "cost_rule_version"
      ],
      "properties": {
        "training_run_id": {"type": "string", "minLength": 1},
        "dataset_snapshot_id": {"type": "string", "pattern": "^ds_[0-9a-f]+$"},
        "schema_manifest_id": {"type": "string", "pattern": "^schema_[0-9a-f]+$"},
        "lineage_manifest_id": {"type": "string", "pattern": "^lineage_[0-9a-f]+$"},
        "rulebook_version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "model_family": {"const": "ridge"},
        "feature_names": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "size_feature_name": {"type": "string", "minLength": 1},
        "label_name": {"type": "string", "minLength": 1},
        "split_protocol": {"type": "string", "minLength": 1},
        "random_seed": {"type": "integer"},
        "final_test_runs": {"const": 0},
        "ridge_alphas": {
          "type": "array",
          "prefixItems": [
            {"const": 0.1},
            {"const": 1.0},
            {"const": 10.0},
            {"const": 100.0}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "preprocessor_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^preprocessor_artifact_[0-9a-f]{64}$"}
        },
        "trial_batch_id": {"type": "string", "minLength": 1},
        "factor_report_id": {
          "type": "string",
          "pattern": "^factor_report_[0-9a-f]{64}$"
        },
        "portfolio_backtest_id": {
          "type": "string",
          "pattern": "^portfolio_backtest_[0-9a-f]{64}$"
        },
        "portfolio_rule_version": {"type": "string", "minLength": 1},
        "cost_rule_version": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio Target Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["factor_report_id", "model_id", "portfolio_protocol_id", "dataset_snapshot_id", "trial_batch_id", "portfolio_rule_version", "evidence_classification", "candidate_factor_names", "records"],
  "properties": {
    "factor_report_id": {"type": "string", "pattern": "^factor_report_[0-9a-f]{64}$"},
    "model_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9_]*_model_[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "portfolio_protocol_id": {
      "oneOf": [
        {"type": "string", "pattern": "^portfolio_protocol_[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "dataset_snapshot_id": {"type": "string", "pattern": "^ds_[0-9a-f]+$"},
    "trial_batch_id": {"type": "string", "pattern": "^trial_batch_[0-9a-f]{64}$"},
    "portfolio_rule_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "evidence_classification": {"enum": ["DEVELOPMENT", "REUSED_DEVELOPMENT_NOT_OUT_OF_SAMPLE"]},
    "candidate_factor_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/PortfolioTargetRecord"}}
  },
  "$defs": {
    "PortfolioTargetPositionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "target_weight", "score"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SZ|SH|BJ)$"},
        "target_weight": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "score": {"type": "number"}
      }
    },
    "PortfolioTargetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_date", "positions", "cash_weight"],
      "properties": {
        "decision_date": {"type": "string", "format": "date"},
        "positions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/PortfolioTargetPositionRow"}},
        "cash_weight": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
